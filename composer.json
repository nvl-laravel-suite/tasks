{
    "name": "nvl/tasks",
    "description": "Tenant-safe task management for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tasks",
        "task-management"
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "nvl/activity": "^5.0",
        "nvl/media": "^5.0",
        "nvl/filterable": "^5.0",
        "nvl/tenancy": "^5.0",
        "nvl/translatable": "^5.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Tasks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Tasks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Tasks\\Providers\\TasksServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/activity": "Enables canonical task history and durable Activity delivery.",
        "nvl/media": "Enables explicit private task attachments through the loaded Media provider.",
        "nvl/tenancy": "Enables enforcing tenant ownership, scoped execution, adoption, and captured tenant queue contexts."
    },
    "conflict": {
        "nvl/activity": "<5.0 || >=6.0",
        "nvl/media": "<5.0 || >=6.0",
        "nvl/tenancy": "<5.0 || >=6.0"
    }
}
