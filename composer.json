{
    "name": "nvl/tasks",
    "description": "Tenant-safe task records and assignments for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "tasks", "task-management"],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/content": "^2.0",
        "nvl/data": "^2.0",
        "nvl/media": "^2.0",
        "nvl/metafields": "^2.0",
        "nvl/support": "^2.0",
        "nvl/tenancy": "^2.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Tasks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Tasks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": ["@format:test", "@analyse", "@test"],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Tasks\\Providers\\TasksServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
