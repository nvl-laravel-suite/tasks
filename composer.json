{
    "name": "nvl/tasks",
    "description": "Tenant-safe task management for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tasks",
        "task-management"
    ],
    "require": {
        "ext-json": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^6.0",
        "php": "^8.4",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/activity": "^6.0",
        "nvl/filterable": "^6.0",
        "nvl/media": "^6.0",
        "nvl/ownership": "^6.0",
        "nvl/tenancy": "^6.0",
        "nvl/translatable": "^6.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/typescript-transformer": "^3.3",
        "symfony/process": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Tasks\\": "src/",
            "Nvl\\Tasks\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Tasks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Tasks\\Providers\\TasksServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/activity": "Enables canonical task history and durable Activity delivery.",
        "nvl/media": "Enables explicit private task attachments through the loaded Media provider.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/tenancy": "Temporary legacy tenancy bridge for existing tenant installations; native ownership does not require it.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "conflict": {
        "nvl/activity": "<6.0 || >=7.0",
        "nvl/media": "<6.0 || >=7.0",
        "nvl/ownership": "<6.0 || >=7.0",
        "nvl/tenancy": "<6.0 || >=7.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/tasks",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/tasks",
        "docs": "https://github.com/nvl-laravel-suite/tasks#readme",
        "issues": "https://github.com/nvl-laravel-suite/tasks/issues",
        "security": "https://github.com/nvl-laravel-suite/tasks/security/policy"
    }
}
